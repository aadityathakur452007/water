# Python Workers API (workers/api) — update via dev:  cd workers/api && python -m uvicorn app.main:app --port 8000
API_URL=http://127.0.0.1:8000
# mock = render fixtures offline; live = call the real worker (requires the worker running)
API_MODE=mock
# Firebase phone OTP (client); when unset, dev login (worker DEV_AUTH=1) is used
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_ADMIN_PHONE=
