# Python Workers API (workers/api) — update via dev:  cd workers/api && python -m uvicorn app.main:app --port 8000
API_URL=http://127.0.0.1:8000
# live = call the real worker (default, production-safe); mock = render fixtures offline (opt-in for dev)
API_MODE=live
# Admin login is phone + access code (POST /v1/auth/admin/login, device id "admin-web").
# The worker door is gated by `access_code_login_enabled=1` in D1 config
# (backend 014 migration owns the final flag name — this file documents the contract, not the schema).
# No Firebase/phone-OTP vars: the OTP form + Firebase bundle were deleted in 028.

# Cloudflare Workers Builds (root directory: apps/admin_app)
#   Build command:  npm run build:cloudflare
#   Deploy command: npx wrangler deploy
#   Vars: API_URL=https://water.adityathakur452007.workers.dev (bare origin)
