// Cloudflare Workers (Workers Builds) deploy config — premium admin dashboard.
//
// Cloudflare dashboard settings for this project:
//   Build command:    npm run build:cloudflare
//   Deploy command:   npx wrangler deploy
//   Root directory:   apps/admin_app
//
// Build variables (dashboard, or wrangler secret put for secrets):
//   API_URL=https://water-admin.adityathakur452007.workers.dev   (admin surface)
//   OPS_API_URL=https://water-ops.adityathakur452007.workers.dev (vendor portal)
//   Both are bare origins; /v1/... is appended server-side.
//   Admin login is phone + access code — no client env vars. The worker door
//   is gated by `access_code_login_enabled=1` (backend 014 owns the final name).
//   API_MODE unset → live (fixtures only with explicit API_MODE=mock)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shodasha-admin",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".output/public"
  },
  "services": [
    {
      // Admin backend Worker (045 split). The BFF prefers bindings over
      // public HTTPS, which the edge can reject on worker-to-worker fetch
      // (1003 historically, opaque 403 now).
      "binding": "WATER_API",
      "service": "water-admin"
    },
    {
      // Vendor portal backend (same Python codebase, vendor+rider surface).
      "binding": "OPS_API",
      "service": "water-ops"
    }
  ],
  "observability": {
    "enabled": true
  }
}
