{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "water",
	"main": "src/entry.py",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": [
		"python_workers",
		"python_dedicated_snapshot"
	],
	"d1_databases": [
		{
			// Available in the Worker as env.DB (see src/entry.py).
			"binding": "DB",
			"database_name": "shodasha",
			// From `npx wrangler d1 create shodasha` — paste the real id here.
			// Deploy fails fast with a clear error until this is replaced.
			"database_id": "da762aad-1d5c-46eb-992e-acc79505cc95",
			"migrations_dir": "src/app/db/migrations"
		}
	],
	"vars": {
		// Non-secret tunables only. Secrets (Razorpay, webhook, VPA) go via
		// `wrangler secret put` — never here. FIREBASE_PROJECT_ID is public
		// (it ships inside every client-side firebaseConfig) so it belongs
		// here, not in secrets.
		// UPI money is Razorpay-only (no fake exists): money doors need secrets
		// UPI_KEY_ID, UPI_KEY_SECRET, UPI_WEBHOOK_SECRET, AGENCY_UPI_VPA
		// (`wrangler secret put`). Razorpay dashboard → Settings → Webhooks:
		// POST https://water.<account>.workers.dev/v1/webhooks/upi with
		// payment.captured + payment.failed events.
		"APP_ENV": "prod",
		"FIREBASE_PROJECT_ID": "water-delivery-system-26"
	},
	"triggers": {
		// Scheduler (app/jobs/scheduler.py) runs here once its async-D1
		// conversion lands (T2). 15 min matches QUOTE_TTL_MIN cleanup.
		"crons": ["*/15 * * * *"]
	},
	"observability": {
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": false,
			"head_sampling_rate": 1,
			"persist": true
		}
	},
	"env": {
		"staging": {
			"name": "water-staging",
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "shodasha-staging",
					"database_id": "05772775-a957-4852-8ec3-6b14082d4a62",
					"migrations_dir": "src/app/db/migrations"
				}
			],
			"vars": {
				// Synthetic benchmark staging only. No secrets here.
				"APP_ENV": "staging",
				"FIREBASE_PROJECT_ID": "water-delivery-system-26",
				"OBS_LOG_SAMPLE_RATE": "0.1",
				"OBS_SLOW_MS": "750",
				// The benchmark exits from one source IP; keep the edge throttle
				// out of the way so latency numbers are not 429s.
				"THROTTLE_ANON_PER_MIN": "100000"
			},
			"triggers": {
				// No cron in staging: synthetic due subscriptions must not mutate
				// the dataset while a benchmark is running.
				"crons": []
			},
			"observability": {
				"logs": {
					"enabled": true,
					"head_sampling_rate": 1,
					"invocation_logs": true,
					"persist": true
				},
				"traces": {
					"enabled": true,
					"head_sampling_rate": 1,
					"persist": true
				}
			}
		}
	}
}
